{
	"name": "malazite",
	"version": "0.1.0",
	"description": "Self-hosted Python programming judge.",
	"keywords": [
		"python",
		"programming",
		"judge",
		"online-judge"
	],
	"license": "MIT",
	"author": "Zafran Prayata Wiza",
	"repository": "github:zf-ran/malazite",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"dev:backend": "npx bun --watch src/index.ts",
		"dev:frontend": "npx bun run build-frontend.js",
		"build:backend": "npx bun run build-backend.js --minify",
		"build:frontend": "npx bun run build-frontend.js --minify"
	},
	"dependencies": {
		"bun": "^1.4.2"
	},
	"devDependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/highlight": "^0.19.8",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/language": "^6.12.4",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.5",
		"@codemirror/view": "^6.43.12",
		"@fastify/cookie": "^11.1.2",
		"@fastify/static": "^10.1.4",
		"@fastify/type-provider-json-schema-to-ts": "^5.0.0",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/material-symbols-outlined": "^5.3.6",
		"@jsonapi-serde/server": "^1.10.1",
		"@mathjax/mathjax-fira-font": "^4.1.3",
		"@mathjax/mathjax-mhchem-font-extension": "^4.1.3",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.2",
		"codemirror": "^6.0.2",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.12.5",
		"isomorphic-dompurify": "^3.19.0",
		"marked": "^18.0.13",
		"mathjax": "^4.1.3",
		"pino-pretty": "^13.1.3",
		"yaml": "^2.9.1",
		"zod": "^4.6.5"
	},
	"allowScripts": {
		"bun@1.4.2": true
	}
}
